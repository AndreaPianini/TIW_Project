MODIFICA VOTO
      @startuml
      actor Docente
      participant "RegisteredStudentsDetails (JS)" as JS_Iscritti 
      participant "Servlet: Modifica" as ModificaServlet #Lightblue
      participant "StudenteDAO" as StudenteDAO #Lightblue
      participant "SingleStudentDetails (JS)" as JS_Pannello
      participant "Servlet: ModificaVoto" as ModificaVotoServlet #Lightblue
      participant "DocenteDAO" as DocenteDAO #Lightblue
      participant "JS: tabella iscritti" as UI_Table
      
      Docente -> JS_Iscritti : click Modifica (studente)
      JS_Iscritti -> ModificaServlet : GET /Modifica?studenteID=…&corsoID=…&dataAppello=…
      ModificaServlet -> StudenteDAO : getStudenteInfo()\ngetVotoByAppello()
      StudenteDAO --> ModificaServlet : studente + voto attuale
      ModificaServlet --> JS_Iscritti : JSON { studente, voto, votiPossibili }
      
      JS_Iscritti -> JS_Pannello : update(json)
      
      Docente -> JS_Pannello : click “Salva” nuovo voto
      JS_Pannello -> ModificaVotoServlet : POST /ModificaVoto\nstudenteID, corsoID, dataAppello, voto
      ModificaVotoServlet -> StudenteDAO : checkRegistrazione(studenteID, appello)
      ModificaVotoServlet -> DocenteDAO : modificaVoto(voto, corsoID, dataAppello, studenteID)
      DocenteDAO --> ModificaVotoServlet : conferma
      ModificaVotoServlet --> JS_Pannello : HTTP 200 OK
      
      JS_Pannello -> UI_Table : refresh iscritti → show(courseId, appealDate)
      @enduml

INSERIMENTO VOTI MUTLIPLI
      @startuml
      actor Docente
      participant "RegisteredStudentsDetails (JS)" as JS_Iscritti
      participant "MultipleInsertionModal (JS)" as JS_Modal
      participant "Servlet: GetStudentiSenzaVotoByAppello" as GetSenzaVoto #Lightblue
      participant "DocenteDAO" as DAO #Lightblue
      participant "Servlet: ModificaVoto" as ModificaVotoServlet #Lightblue
      participant "DocenteDAO" as DocenteDAO #Lightblue
      participant "JS: tabella iscritti" as UI_Table
      
      Docente -> JS_Iscritti : click “Voti Multipli”
      JS_Iscritti -> JS_Modal : open(courseId, appealDate)
      JS_Modal -> GetSenzaVoto : GET /getStudentiSenzaVotoByAppello?corsoID=…&dataAppello=…
      GetSenzaVoto -> DAO : getStudentiSenzaVoto(corsoID, dataAppello)
      DAO --> GetSenzaVoto : studenti senza voto
      GetSenzaVoto --> JS_Modal : JSON { studenti senza voto }
      
      JS_Modal -> JS_Modal : mostra modale + form multiplo
      
      Docente -> JS_Modal : click “Salva Voti”
      loop per ogni voto inserito
        JS_Modal -> ModificaVotoServlet : POST /ModificaVoto\nstudenteID, corsoID, dataAppello, voto
        ModificaVotoServlet -> DocenteDAO : modificaVoto(...)
        DocenteDAO --> ModificaVotoServlet : conferma
        ModificaVotoServlet --> JS_Modal : HTTP 200 OK
      end
      
      JS_Modal -> UI_Table : refresh iscritti → show(courseId, appealDate)
      @enduml

MOSTRA VERBALE
      @startuml
      actor Docente
      participant "VerbaliList (JS)" as JS_Verbali
      participant "Servlet: MostraVerbaleCreato" as MostraVerbale #Lightblue
      participant "VerbaleDAO" as VerbaleDAO #Lightblue
      participant "AppelloDAO" as AppelloDAO #Lightblue
      participant "CorsoDAO" as CorsoDAO #Lightblue
      participant "Verbale dettagliato" as UI_Report
      
      Docente -> JS_Verbali : click Verbale (id=…)
      JS_Verbali -> MostraVerbale : GET /MostraVerbaleCreato?verbaleID=…
      MostraVerbale -> VerbaleDAO : getStudentiAndInfoByVerbale(verbaleID)
      MostraVerbale -> AppelloDAO : getAppelloByVerbale(verbaleID)
      MostraVerbale -> CorsoDAO : getCorsoById(appello.corsoID)
      VerbaleDAO --> MostraVerbale : verbale + studenti + voti
      AppelloDAO --> MostraVerbale : appello
      CorsoDAO --> MostraVerbale : corso
      MostraVerbale --> JS_Verbali : JSON { verbale, appello, corso, studenti, voti }
      
      JS_Verbali -> UI_Report : show(json)
      @enduml

CARICAMENTO INIZIALE
      @startuml
      actor Docente
      participant "PageOrchestrator (JS)" as JS_Orchestrator
      participant "CoursesList (JS)" as JS_Corsi
      participant "Servlet: VaiHomeDocente" as VaiHome #Lightblue
      participant "DocenteDAO" as DAO #Lightblue
      participant "VerbaliList (JS)" as JS_Verbali
      
      Docente -> JS_Orchestrator : carica pagina (onload)
      JS_Orchestrator -> JS_Corsi : show()
      
      JS_Corsi -> VaiHome : GET /VaiHomeDocente
      VaiHome -> DAO : getCorsiAndAppelliByDocente(docenteID)
      DAO --> VaiHome : corsi + appelli
      VaiHome --> JS_Corsi : JSON { corsi, appelli }
      
      JS_Corsi -> JS_Corsi : update(json) → mostra lista corsi + appelli
      
      JS_Orchestrator -> JS_Verbali : show()
      JS_Verbali -> Servlet: MostraVerbali : GET /MostraVerbali
      MostraVerbali -> DAO : getVerbaliByDocente(docenteID)
      DAO --> MostraVerbali : lista verbali
      MostraVerbali --> JS_Verbali : JSON { verbali }
      
      JS_Verbali -> JS_Verbali : update(json) → mostra lista verbali
      @enduml




