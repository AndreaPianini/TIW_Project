
LOGIN
@startuml
    actor Utente
    participant "Login.html +\nLoginController.js" as Login
    participant "Servlet: CheckLogin" as CheckLogin #Lightblue
    participant "UtenteDAO" as DAO #Lightblue
    participant "Sessione" as Sessione #Lightblue
    participant "Window" as Window
    
    Utente -> Login : click submit
    Login -> CheckLogin : AJAX POST \nusername, password
    CheckLogin -> DAO : checkCredenziali\nusername, password
    DAO -> CheckLogin : user || null
    CheckLogin --> Login : [Exception, Errori \nStatusCode 400/401/500]
    Login <- Login : [Show error message]
    CheckLogin -> Sessione : [no errori] setAttribute("user", user)
    CheckLogin --> Login : utente JSON\nStatusCode 200
    Login -> Window : utente.role == "Docente" ? \nlocation.href("DocenteHome.html")
    Login -> Window : utente.role == "Studente" ? \nlocation.href("StudenteHome.html")
 @enduml


VERBALIZZAZIONE 
@startuml
    actor Docente
    participant "Lista studenti" as JS_View
    participant "creaVerbale() helper" as JS_Helper
    participant "Servlet: Verbalizza" as Verbalizza #Lightblue
    participant "DocenteDAO" as DAO #Lightblue
    participant "Servlet: MostraVerbaleCreato" as MostraVerbale #Lightblue
    participant "VerbaleDAO" as VerbaleDAO #Lightblue
    participant "AppelloDAO" as AppelloDAO #Lightblue
    participant "CorsoDAO" as CorsoDAO #Lightblue
    participant "Verbale dettagliato" as UI_Report
    
    Docente -> JS_View : click Verbalizza
    JS_View -> JS_Helper : createReport(courseId, appealDate)
    
    JS_Helper -> Verbalizza : POST /Verbalizza\n(corsoID, dataAppello)
    Verbalizza -> DAO : VerbalizzaValutazioni(corsoID, dataAppello)
    DAO --> Verbalizza : return verbaleID
    Verbalizza --> JS_Helper : JSON { verbaleID }
    
    JS_Helper -> MostraVerbale : GET /MostraVerbaleCreato?verbaleID
    MostraVerbale -> VerbaleDAO : getVerbaleInfo(verbaleID)
    MostraVerbale -> AppelloDAO : getAppelloByVerbale(verbaleID)
    MostraVerbale -> CorsoDAO : getCorsoById(courseId)
    VerbaleDAO --> MostraVerbale : info
    AppelloDAO --> MostraVerbale : appello
    CorsoDAO --> MostraVerbale : corso
    MostraVerbale --> JS_Helper : JSON { verbale, corso, appello, studenti }
    
    JS_Helper -> UI_Report : verbale.show(json)
    JS_Helper -> JS_View : update( )
    
@enduml


VEDI ISCRITTI

    @startuml
    actor Docente
    participant "CourseAppeals (JS)" as JS_Appelli
    participant "Servlet: VediIscritti" as VediIscritti #Lightblue
    participant "DocenteDAO" as DAO #Lightblue
    participant "Lista Iscritti" as UI_Table
    
    Docente -> JS_Appelli : click Appello
    JS_Appelli -> UI_Table : show(courseId, appealDate)
    
    UI_Table -> VediIscritti : GET /VediIscritti?corsoID=…&dataAppello=…
    VediIscritti -> DAO : getIscrittiByAppello(corsoID, dataAppello)
    DAO --> VediIscritti : lista iscritti + voti
    VediIscritti --> UI_Table : JSON { studenti, voti }
    
    UI_Table -> UI_Table : update(json)
    @enduml

