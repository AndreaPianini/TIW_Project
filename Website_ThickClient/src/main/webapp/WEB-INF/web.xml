<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="https://jakarta.ee/xml/ns/jakartaee"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
	version="6.0">
	<display-name>Website_ThickClient</display-name>

	<context-param>
		<param-name>dbUrl</param-name>
		<param-value>jdbc:mysql://127.0.0.1:3306/db_esami?serverTimezone=UTC</param-value>
	</context-param>
	<context-param>
		<param-name>dbUser</param-name>
		<param-value>root</param-value>
	</context-param>
	<context-param>
		<param-name>dbPassword</param-name>
		<param-value>root7777</param-value>
	</context-param>
	<context-param>
		<param-name>dbDriver</param-name>
		<param-value>com.mysql.cj.jdbc.Driver</param-value>
	</context-param>

	<filter>
		<filter-name>Checker</filter-name>
		<filter-class>Filters.Checker</filter-class>
	</filter>
	<filter>
		<filter-name>DocenteChecker</filter-name>
		<filter-class>Filters.DocenteChecker</filter-class>
	</filter>
	<filter>
		<filter-name>StudenteChecker</filter-name>
		<filter-class>Filters.StudenteChecker</filter-class>
	</filter>
	<filter>
		<filter-name>NoCacher</filter-name>
		<filter-class>Filters.NoCacher</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>NoCacher</filter-name>
		<url-pattern>/VaiHomeDocente</url-pattern>
		<url-pattern>/VaiHomeStudente</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>Checker</filter-name>
		<url-pattern>/VaiHomeDocente</url-pattern>
		<url-pattern>/VaiHomeStudente</url-pattern>
		<url-pattern>/Logout</url-pattern>
		<url-pattern>/VediVoto</url-pattern>
		<url-pattern>/RifiutaVoto</url-pattern>
		<url-pattern>/VediIscritti</url-pattern>
		<url-pattern>/Pubblica</url-pattern>
		<url-pattern>/Modifica</url-pattern>
		<url-pattern>/ModificaVoto</url-pattern>
		<url-pattern>/Verbalizza</url-pattern>
		<url-pattern>/MostraVerbali</url-pattern>
		<url-pattern>/MostraVerbaleCreato</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>DocenteChecker</filter-name>
		<url-pattern>/VaiHomeDocente</url-pattern>
		<url-pattern>/VediIscritti</url-pattern>
		<url-pattern>/Pubblica</url-pattern>
		<url-pattern>/Modifica</url-pattern>
		<url-pattern>/ModificaVoto</url-pattern>
		<url-pattern>/Verbalizza</url-pattern>
		<url-pattern>/MostraVerbali</url-pattern>
		<url-pattern>/MostraVerbaleCreato</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>StudenteChecker</filter-name>
		<url-pattern>/VaiHomeStudente</url-pattern>
		<url-pattern>/VediVoto</url-pattern>
		<url-pattern>/RifiutaVoto</url-pattern>
	</filter-mapping>

	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
	</welcome-file-list>

</web-app>